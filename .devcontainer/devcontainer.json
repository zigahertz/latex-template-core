{
  "name": "latex-env",
  "image": "texlive/texlive:latest",
  "customizations": {
    "vscode": {
      "extensions": ["James-Yu.latex-workshop"],
      "settings": {
        "latex-workshop.latex.tools": [
          {
            "name": "latexmk",
            "command": "latexmk",
            "args": ["src/main.tex"]
          }
        ]
      }
    }
  }
}
